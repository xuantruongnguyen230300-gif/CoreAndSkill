<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CoreAndSkill.Api</RootNamespace>
    <UserSecretsId>4cc79a6c-431b-4773-98f1-045330051cea</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CoreAndSkill.Core.Web\CoreAndSkill.Core.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `dotnet ef` đòi startup project tham chiếu gói này để nạp design-time services — chỉ dùng
         lúc sinh migration (docs/database/script-runbook.md §4), không chạy ở production. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Development.json mang giá trị dev công khai (docs/adr/0110) — không chép vào
         gói publish, chỉ dùng khi chạy `dotnet build`/`dotnet run` ở máy dev (docs/RULES-BE.md, S23 vế (e)). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Bộ sinh XML-comment của Microsoft.AspNetCore.OpenApi (ADR-0118) tự đẩy kiểu vào assembly host — trái luật A7 (host
         chỉ chứa Program). Host không gọi AddOpenApi nên bộ sinh không có việc ở đây; gỡ khỏi lượt biên dịch của host. -->

  <Target Name="RemoveOpenApiSourceGeneratorFromHost" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

</Project>
