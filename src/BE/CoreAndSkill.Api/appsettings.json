{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Core": ""
  },
  "Core": {
    "Auth": {
      "CookieName": "coreandskill.session",
      "AntiforgeryCookieName": "coreandskill.antiforgery",
      "SessionMinutes": 30,
      "SessionAbsoluteHours": 12,
      "AllowedOrigins": []
    },
    "Identity": {
      "Password": {
        "RequiredLength": 8,
        "RequireDigit": true,
        "RequireLowercase": true,
        "RequireUppercase": false,
        "RequireNonAlphanumeric": false,
        "RequiredUniqueChars": 1
      },
      "Lockout": {
        "MaxFailedAttempts": 5,
        "DurationMinutes": 15
      },
      "Login": {
        "FailureFloorMs": 500
      }
    },
    "BackgroundJobs": {
      "StaleDataCleanupIntervalHours": 24
    }
  }
}
