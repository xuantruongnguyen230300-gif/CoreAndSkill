{
  "name": "fe",
  "version": "0.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:kieu": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@ngx-translate/core": "18.0.0",
    "@primeuix/themes": "2.0.2",
    "primeicons": "8.0.1",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "5.1.15",
    "angular-eslint": "21.4.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "jasmine-core": "5.9.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
