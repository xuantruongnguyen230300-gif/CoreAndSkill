# Mẫu cho docker-compose.yml — docs/wiki-core/be/18-trien-khai-va-van-hanh.md §7.
# Copy thành ".env" (đã bị .gitignore loại, không commit) rồi điền giá trị thật.
# Mọi giá trị dưới đây là PLACEHOLDER, không phải bí mật thật.

POSTGRES_DB=coreandskill
POSTGRES_OWNER_USER=coreandskill_owner
POSTGRES_OWNER_PASSWORD=doi-gia-tri-nay
POSTGRES_APP_USER=coreandskill_app
POSTGRES_APP_PASSWORD=doi-gia-tri-nay

CORE_AUTH_COOKIE_NAME=coreandskill.session
CORE_AUTH_ANTIFORGERY_COOKIE_NAME=coreandskill.antiforgery
CORE_AUTH_SESSION_MINUTES=30
CORE_AUTH_SESSION_ABSOLUTE_HOURS=12
# Origin THẬT của FE đã triển khai — https://... đủ scheme và cổng.
CORE_AUTH_ALLOWED_ORIGIN=https://doi-thanh-domain-that.example

# Core:Bootstrap:* — chỉ cần khi chạy `docker compose run api ... core bootstrap` lần đầu
# (docs/database/script-runbook.md §3.3 bước 4-5).
CORE_BOOTSTRAP_SYSTEM_TENANT_CODE=HETHONG
CORE_BOOTSTRAP_SYSTEM_TENANT_NAME=Don vi he thong
CORE_BOOTSTRAP_FIRST_TENANT_CODE=DEMO
CORE_BOOTSTRAP_FIRST_TENANT_NAME=Don vi demo
CORE_BOOTSTRAP_OPERATOR_USERNAME=superadmin
CORE_BOOTSTRAP_OPERATOR_PASSWORD=doi-gia-tri-nay
CORE_BOOTSTRAP_OPERATOR_EMAIL=doi-thanh-email-that@example.com
CORE_BOOTSTRAP_ADMIN_USERNAME=admin
CORE_BOOTSTRAP_ADMIN_PASSWORD=doi-gia-tri-nay
CORE_BOOTSTRAP_ADMIN_EMAIL=doi-thanh-email-that@example.com
